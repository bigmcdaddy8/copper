# Historical/manual-testing reference only as of 0W-4A. Fires the daily
# bounded ES capture at 16:55 America/Chicago on the five ordinary CME
# trading-date launch evenings (Sun-Thu). Persistent=false: a host that
# misses 16:55 (e.g. late boot) does NOT launch the trading-date collector
# hours later — the miss stays a miss and is visible as operator evidence
# (0W-2 Attempt-4 lesson).
#
# 0W-4A: [Install] intentionally removed. Enabling BOTH this timer and
# dicks-lab-launch-gate.timer would give the collector two independent
# 16:55 triggers — one gated by preflight, one not — reintroducing exactly
# the fail-open risk the gate architecture exists to prevent. The single
# production trigger for dicks-lab-es-session.service is now
# dicks-lab-launch-gate.timer -> dicks-lab-launch-gate.service (fail-closed
# on the date-scoped preflight marker). This unit is kept only for a manual
# `systemctl start dicks-lab-es-session.timer` one-shot test invocation; it
# must never be `systemctl enable`d in production.

[Unit]
Description=Daily Dick's Laboratory ES trading-date capture — Sun–Thu 16:55 America/Chicago (manual/test invocation only, see header)
Documentation=file:/home/temckee8/Documents/REPOs/copper/docs/dicks_laboratory/FULL_SESSION_MULTIDAY_SOAK_REPORT.md

[Timer]
OnCalendar=Sun,Mon,Tue,Wed,Thu *-*-* 16:55:00 America/Chicago
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=dicks-lab-es-session.service
