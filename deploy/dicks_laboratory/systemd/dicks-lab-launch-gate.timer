# 0W-4A: recurring trigger for dicks-lab-launch-gate.service, one run per
# ordinary CME trading-date launch evening (Sun-Thu) at 16:55 America/Chicago
# -- the single production trigger for dicks-lab-es-session.service. This
# timer, not dicks-lab-es-session.timer, is the real recurring launch path:
# dicks-lab-es-session.timer's own [Install] was removed (see that unit's
# header) specifically so there is exactly one way the collector can start
# on a schedule, with the fail-closed marker check always in front of it.
# Persistent=false: same 0W-2 Attempt-4 lesson -- a missed launch window
# must stay a visible miss, not a late catch-up run.
#
# NOT enabled as part of 0W-4A. 0W-4A is a design/readiness phase; arming
# (systemctl enable --now, both this and dicks-lab-preflight-gate.timer)
# requires separate PO/Human authorization.

[Unit]
Description=Daily Dick's Laboratory fail-closed launch gate — Sun-Thu 16:55 America/Chicago
Documentation=file:/home/temckee8/Documents/REPOs/copper/docs/dicks_laboratory/FULL_SESSION_MULTIDAY_SOAK_REPORT.md

[Timer]
OnCalendar=Sun,Mon,Tue,Wed,Thu *-*-* 16:55:00 America/Chicago
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=dicks-lab-launch-gate.service

[Install]
WantedBy=timers.target
