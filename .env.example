# Tradier API credentials
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Production API key (from your Tradier brokerage account settings)
TRADIER_API_KEY=your_production_api_key_here

# Sandbox API key (from your Tradier paper-trading account settings)
TRADIER_SANDBOX_API_KEY=your_sandbox_api_key_here

# Active environment: "production" or "sandbox" (default: production)
# Override on the CLI with --sandbox
TRADIER_ENV=production

# Tastytrade read-only diagnostic OAuth credentials
# Reuse an existing OAuth application or create one at my.tastytrade.com, then
# create a personal grant. The refresh token enables unattended runs. K9's current
# Tastytrade integration is read-only even when the application also has trade scope.
TW_APP_NAME=k9-tastytrade-diagnostic
TW_CLIENT_ID=your_tastytrade_read_only_client_id_here
TW_CLIENT_SECRET=your_tastytrade_read_only_client_secret_here
TW_REFRESH_TOKEN=your_tastytrade_read_only_refresh_token_here
TW_ACCOUNT_NUMBER=your_tastytrade_account_number_here
